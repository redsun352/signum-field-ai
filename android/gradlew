#!/bin/sh

# Simple Gradle bootstrap for CI/local builds. The wrapper JAR is not committed.
# Use installed Gradle when available; otherwise download a pinned distribution.
set -eu
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
GRADLE_VERSION=8.13
GRADLE_HOME="${APP_HOME}/.gradle-dist/gradle-${GRADLE_VERSION}"
if [ ! -x "${GRADLE_HOME}/bin/gradle" ]; then
  mkdir -p "${APP_HOME}/.gradle-dist"
  ARCHIVE="${APP_HOME}/.gradle-dist/gradle-${GRADLE_VERSION}-bin.zip"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL -o "${ARCHIVE}" "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip"
  elif command -v wget >/dev/null 2>&1; then
    wget -q -O "${ARCHIVE}" "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip"
  else
    echo "curl or wget is required" >&2
    exit 1
  fi
  unzip -q -o "${ARCHIVE}" -d "${APP_HOME}/.gradle-dist"
fi
exec "${GRADLE_HOME}/bin/gradle" "$@"
